  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "orval": "^8.48.0",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
