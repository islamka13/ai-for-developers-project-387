{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/big-pickle",
  "permission": {
    "external_directory": {
      "/github/workflow/*": "allow",
      "/home/runner/work/_temp/_github_workflow/*": "allow"
    },
    "doom_loop": "deny"
  },
  "mcp": {
    "servers": {
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:RENDER_API_KEY}"
        }
      }
    }
  }
}
